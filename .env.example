# ===== 应用配置 =====
# Flask密钥（用于session加密，生产环境必须修改为随机字符串）
SECRET_KEY=your-random-secret-key-change-this

# 运行环境: development / production
FLASK_ENV=development

# 服务端口
PORT=5000

# 数据库文件路径（默认当前目录下 users.db）
DB_PATH=users.db

# ===== 腾讯云短信配置 =====
# 在 https://console.cloud.tencent.com/cam/capi 获取
TENCENT_SECRET_ID=your-secret-id
TENCENT_SECRET_KEY=your-secret-key

# 在 https://console.cloud.tencent.com/smsv2 获取
# 短信应用 SDK AppID
SMS_SDK_APP_ID=1400000000

# 短信签名（需在腾讯云审核通过）
SMS_SIGN_NAME=你的签名

# 短信模板ID（需在腾讯云创建并审核通过）
# 模板内容示例: 您的验证码为{1}，{2}分钟内有效，请勿泄露给他人。
SMS_TEMPLATE_ID=123456
